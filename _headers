/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; media-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/api/*
  Cache-Control: no-store

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  Cache-Control: public, max-age=604800

/pedido.html
  X-Robots-Tag: noindex
  Cache-Control: no-store

/admin.html
  X-Robots-Tag: noindex
  Cache-Control: no-store

/lote.html
  X-Robots-Tag: index, follow